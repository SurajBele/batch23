pipeline {
    agent { label 'node1' }
    stages {
        stage('pull') { 
            steps {
                git branch: 'main', url: 'https://github.com/SurajBele/studentdata.git'
                echo "pull successful" 
            }
        }
        stage('build') { 
            steps {
                echo "build successful"
            }
        }
          stage('test') { 
            steps {
                echo "testing successful"
            }
        }
        stage('Deploy') { 
            steps {
                echo "deploy successful"
                sh 'hostname'
            }
        }
    }
}
